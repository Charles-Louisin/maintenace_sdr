{
  "expo": {
    "name": "BATIS",
    "slug": "batis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.batis.maintenance",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDECD8",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.batis.maintenance",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#1F3B2D",
          "icon": "./assets/android-icon-monochrome.png"
        }
      ],
      "expo-sharing",
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BATIS utilise Face ID pour déverrouiller votre session sans ressaisir le mot de passe."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDECD8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-updates",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ],
            "useLegacyPackaging": true,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "enableBundleCompression": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BATIS utilise vos photos pour l’image d’une salle, votre photo de profil ou le fond de connexion.",
          "cameraPermission": false
        }
      ]
    ],
    "scheme": "batis",
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "apiUrl": "",
      "eas": {
        "projectId": "c75e8d87-e6d9-418b-8fb5-2cbb26b45d73"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "backgroundColor": "#FDECD8",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "charles-louisin",
    "updates": {
      "url": "https://u.expo.dev/c75e8d87-e6d9-418b-8fb5-2cbb26b45d73"
    }
  }
}
